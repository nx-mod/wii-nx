#!/usr/bin/env bash
# Extract a Wii disc image into a game's disc/ folder.
#
#   scripts/extract-disc <image> <game-folder>
#
# <image> is your own dump: .iso, .wbfs, .rvz, .gcz or .ciso.
# <game-folder> is the project folder; the disc lands in <game-folder>/disc/
# as files/ and sys/, with sys/main.dol the code the translator reads.
#
# Uses Dolphin's dolphin-tool, so the disc's encryption, the WBFS/RVZ container
# and the partition layout are all handled by code that already knows them.
# Install it with Dolphin (package dolphin-emu / dolphin-emu-tools).
set -euo pipefail

if [ $# -lt 2 ]; then
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi

image=$1
game_dir=$2
disc_dir="$game_dir/disc"

command -v dolphin-tool >/dev/null || {
    echo "dolphin-tool not found: install Dolphin (dolphin-emu-tools)" >&2
    exit 1
}
[ -f "$image" ] || { echo "no such image: $image" >&2; exit 1; }

echo ">> $image"
dolphin-tool header -i "$image"

if [ -e "$disc_dir" ]; then
    echo ">> $disc_dir already exists; remove it to re-extract" >&2
    exit 1
fi

# Space check: the extracted disc is about the size of an uncompressed image.
needed_mb=$(( $(stat -c %s "$image") / 1048576 + 512 ))
free_mb=$(df -Pm "$game_dir" | awk 'NR==2 {print $4}')
if [ "$free_mb" -lt "$needed_mb" ]; then
    echo ">> need about ${needed_mb} MiB free, have ${free_mb} MiB" >&2
    exit 1
fi

mkdir -p "$disc_dir"
# -g: the game (DATA) partition only, which is what the runtime serves.
dolphin-tool extract -g -i "$image" -o "$disc_dir"

if [ ! -f "$disc_dir/sys/main.dol" ]; then
    echo ">> extraction finished but $disc_dir/sys/main.dol is missing" >&2
    exit 1
fi
echo ">> extracted to $disc_dir"
du -sh "$disc_dir"
