#!/usr/bin/env python3
"""Download a Wii system title from Nintendo and unpack its executable.

    scripts/fetch-title <title-id> <output-folder> [--keep]

Channels and other system titles are not on a disc: they live in the console's
NAND, and Nintendo still serves them from the update servers every Wii used.
This downloads one, decrypts it with the title's own key, and writes the
executable as main.dol - the same thing extract-dol produces for a disc, so the
rest of the toolkit is unchanged.

Nothing Nintendo owns is stored in this repository: you download your own copy,
exactly as Dolphin's "Perform Online System Update" does.

    0001000248414341   Mii Channel
    For other titles see wiibrew.org/wiki/Title_database, or fetch-nand for a set.

--keep also writes the metadata and each content next to the executable.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from wiinand import BASE_URL, download  # noqa: E402


def main(argv):
    arguments = [a for a in argv if not a.startswith("-")]
    if len(arguments) != 2:
        print(__doc__)
        return 2
    title_id, output = arguments
    print(f">> title {title_id} from {BASE_URL}")
    result = download(title_id, output, keep="--keep" in argv)
    if not result["executable"]:
        raise SystemExit("no content in this title looks like an executable")
    print(f">> wrote {result['executable']} ({result['executable_bytes']} bytes)")
    print(f">> next: scripts/inspect-dol {result['executable']}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
