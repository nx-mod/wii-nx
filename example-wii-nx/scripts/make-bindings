#!/usr/bin/env python3
"""Turn a game's resolved addresses into the table its build links.

    scripts/make-bindings <resolved.json> <native_bindings.cpp> [--report]

`resolved.json` comes from `resolve-symbols match --out`: the runtime's native
replacements, each with the address it lives at *in that game*. This writes the
C++ table the runtime looks itself up in (see wiicompiled-nx's
runtime/include/native_bindings.h), replacing the weak empty default.

Anything the matcher could not place is simply absent, and the runtime then runs
that game's own code instead of a replacement pointed at the wrong address.
--report lists what is missing, which is the work left for a game.
"""

import json
import os
import sys


def main(argv):
    paths = [value for value in argv if not value.startswith("-")]
    if len(paths) != 2:
        print(__doc__)
        return 2
    resolved_path, output_path = paths

    resolved = json.load(open(resolved_path))
    entries = sorted((name, int(address, 16)) for name, address in resolved.items())

    with open(output_path, "w") as out:
        out.write(f"""// Where this game keeps the functions the runtime replaces.
//
// Generated by example-wii-nx/scripts/make-bindings from
// {os.path.basename(resolved_path)}; do not edit.
//
// Each entry is a symbol the runtime registers and the address that function
// has in this game, found by matching its code against a game we already run.
// Functions absent from this table were not found, so they are not replaced.
#include "native_bindings.h"

namespace NativeBindings {{
namespace {{

// Sorted by name: the runtime binary-searches this at startup.
constexpr Binding kBindings[] = {{
""")
        for name, address in entries:
            out.write(f'    {{"{name}", 0x{address:08X}u}},\n')
        out.write(f"""}};

}}  // namespace

const Binding* Table() noexcept {{ return kBindings; }}

std::size_t TableSize() noexcept {{ return {len(entries)}; }}

}}  // namespace NativeBindings
""")

    print(f"{len(entries)} bindings -> {output_path}")
    if "--report" in argv:
        print("\nThe runtime registers these and this game has no address for them,")
        print("so its own code runs instead. Each is a candidate for hand work:")
        print("  (run resolve-symbols with the game's own map once one exists)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
