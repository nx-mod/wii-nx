#!/usr/bin/env python3
"""Pull main.dol out of a Wii disc image, without extracting the disc.

    scripts/extract-dol <image.iso> <output.dol>

The executable lives in the game partition's system area, which file-level tools
cannot address, and the partition is encrypted. This reads the partition table,
unwraps the title key, and decrypts only the clusters main.dol occupies - seconds
and a few MB, instead of a 4 GB extraction. Use it to inspect a game (ID, entry
point, SDA bases, code signatures) before committing disk space to it.

Plain .iso only. For .wbfs/.rvz, or for the full disc, use extract-disc, which
wraps Dolphin's dolphin-tool.

The AES-128 below is a small, dependency-free implementation (verified against
the FIPS-197 vector), since a stock Python has no AES.
"""

import struct
import sys

# The Wii common key, which every disc's title key is wrapped with. Public
# knowledge and carried by Dolphin; no game data of any kind.
COMMON_KEY = bytes.fromhex("ebe42a225e8593e448d9c5457381aaf7")

CLUSTER = 0x8000          # one encrypted cluster on disc
CLUSTER_HASHES = 0x400    # its hash block
CLUSTER_DATA = 0x7C00     # its payload

SBOX = bytes.fromhex(
    "637c777bf26b6fc53001672bfed7ab76ca82c97dfa5947f0add4a2af9ca472c0"
    "b7fd9326363ff7cc34a5e5f171d8311504c723c31896059a071280e2eb27b275"
    "09832c1a1b6e5aa0523bd6b329e32f8453d100ed20fcb15b6acbbe394a4c58cf"
    "d0efaafb434d338545f9027f503c9fa851a3408f929d38f5bcb6da2110fff3d2"
    "cd0c13ec5f974417c4a77e3d645d197360814fdc222a908846eeb814de5e0bdb"
    "e0323a0a4906245cc2d3ac629195e479e7c8376d8dd54ea96c56f4ea657aae08"
    "ba78252e1ca6b4c6e8dd741f4bbd8b8a703eb5664803f60e613557b986c11d9e"
    "e1f8981169d98e949b1e87e9ce5528df8ca1890dbfe6426841992d0fb054bb16")
INV_SBOX = bytearray(256)
for _index, _value in enumerate(SBOX):
    INV_SBOX[_value] = _index
RCON = (0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36)


def _xtime(value):
    return ((value << 1) ^ 0x1B) & 0xFF if value & 0x80 else value << 1


def _mul(a, b):
    result = 0
    while b:
        if b & 1:
            result ^= a
        a = _xtime(a)
        b >>= 1
    return result


def _expand_key(key):
    words = [list(key[i * 4:i * 4 + 4]) for i in range(4)]
    for i in range(4, 44):
        temp = list(words[i - 1])
        if i % 4 == 0:
            temp = temp[1:] + temp[:1]
            temp = [SBOX[b] for b in temp]
            temp[0] ^= RCON[i // 4 - 1]
        words.append([words[i - 4][j] ^ temp[j] for j in range(4)])
    return words


def _decrypt_block(words, block):
    state = [list(block[row::4]) for row in range(4)]

    def add_round_key(rnd):
        for column in range(4):
            for row in range(4):
                state[row][column] ^= words[rnd * 4 + column][row]

    add_round_key(10)
    for rnd in range(9, -1, -1):
        for row in range(1, 4):
            state[row] = state[row][-row:] + state[row][:-row]
        for row in range(4):
            state[row] = [INV_SBOX[b] for b in state[row]]
        add_round_key(rnd)
        if rnd:
            for column in range(4):
                a = [state[row][column] for row in range(4)]
                state[0][column] = _mul(a[0], 14) ^ _mul(a[1], 11) ^ _mul(a[2], 13) ^ _mul(a[3], 9)
                state[1][column] = _mul(a[0], 9) ^ _mul(a[1], 14) ^ _mul(a[2], 11) ^ _mul(a[3], 13)
                state[2][column] = _mul(a[0], 13) ^ _mul(a[1], 9) ^ _mul(a[2], 14) ^ _mul(a[3], 11)
                state[3][column] = _mul(a[0], 11) ^ _mul(a[1], 13) ^ _mul(a[2], 9) ^ _mul(a[3], 14)
    return bytes(state[row][column] for column in range(4) for row in range(4))


def aes_cbc_decrypt(key, iv, data):
    words = _expand_key(key)
    out = bytearray(len(data))
    previous = iv
    for offset in range(0, len(data), 16):
        block = data[offset:offset + 16]
        plain = _decrypt_block(words, block)
        out[offset:offset + 16] = bytes(p ^ q for p, q in zip(plain, previous))
        previous = block
    return bytes(out)


class Partition:
    """One encrypted partition; reads are in its decrypted address space."""

    def __init__(self, image, offset):
        self.image = image
        image.seek(offset)
        header = image.read(0x2C0)
        title_key_encrypted = header[0x1BF:0x1CF]
        title_id = header[0x1DC:0x1E4]
        self.title_key = aes_cbc_decrypt(COMMON_KEY, title_id + b"\0" * 8, title_key_encrypted)
        self.data_offset = offset + struct.unpack(">I", header[0x2B8:0x2BC])[0] * 4

    def read(self, address, length):
        out = bytearray()
        while length > 0:
            cluster, within = divmod(address, CLUSTER_DATA)
            self.image.seek(self.data_offset + cluster * CLUSTER)
            raw = self.image.read(CLUSTER)
            if len(raw) < CLUSTER:
                break
            # The payload's IV is the *encrypted* H2 hash at 0x3D0, not the decrypted one.
            block = aes_cbc_decrypt(self.title_key, raw[0x3D0:0x3E0], raw[CLUSTER_HASHES:])
            take = min(length, CLUSTER_DATA - within)
            out += block[within:within + take]
            address += take
            length -= take
        return bytes(out)


def game_partition(image):
    """The first DATA partition (type 0), where the game itself lives."""
    image.seek(0x40000)
    table = image.read(0x20)
    for index in range(4):
        count, offset = struct.unpack(">II", table[index * 8:index * 8 + 8])
        if not count:
            continue
        image.seek(offset * 4)
        entries = image.read(count * 8)
        for entry in range(count):
            partition_offset, partition_type = struct.unpack(">II", entries[entry * 8:entry * 8 + 8])
            if partition_type == 0:
                return Partition(image, partition_offset * 4)
    raise SystemExit("no DATA partition found (is this a Wii .iso?)")


def dol_size(header):
    offsets = struct.unpack(">18I", header[0x00:0x48])
    sizes = struct.unpack(">18I", header[0x90:0xD8])
    return max(offset + size for offset, size in zip(offsets, sizes) if size)


def main(argv):
    if len(argv) != 2:
        print(__doc__)
        return 2
    image_path, output_path = argv
    with open(image_path, "rb") as image:
        magic = image.read(4)
        image.seek(0)
        if magic[:4] == b"WBFS":
            raise SystemExit("this is a .wbfs; use extract-disc (dolphin-tool) instead")
        partition = game_partition(image)
        boot = partition.read(0, 0x440)
        game_id = boot[:6].decode("ascii", "replace")
        title = boot[0x20:0x60].split(b"\0")[0].decode("ascii", "replace")
        dol_offset = struct.unpack(">I", boot[0x420:0x424])[0] * 4
        print(f"{game_id}  {title}")
        print(f"  main.dol at partition offset 0x{dol_offset:X}")
        header = partition.read(dol_offset, 0x100)
        size = dol_size(header)
        print(f"  {size} bytes; decrypting")
        data = partition.read(dol_offset, size)
    if len(data) != size:
        raise SystemExit(f"short read: {len(data)} of {size} bytes")
    with open(output_path, "wb") as out:
        out.write(data)
    print(f"  wrote {output_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
