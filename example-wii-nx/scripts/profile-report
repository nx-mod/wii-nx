#!/usr/bin/env python3
"""Where a run's time went, and how much of it is still the game's own code.

    scripts/profile-report <boot.log> [--game <folder>] [--top 20]

The runtime's profiler writes its findings into the boot log as raw addresses:

    [prof] split: game code 55.8%, native runtime 44.2% (10000 samples)
    [prof] game #0 0x80064FD0 9.9%

This turns that into names, says which of those functions the engine already
replaces natively, and adds up what is left. That total is the number to watch
while replacing more of them: it only goes down.

--game points at a folder in wiigames-nx (default: mkwii-nx), for its MAP.txt
and its bindings.
"""

import os
import re
import sys

PROF_SPLIT = re.compile(r"\[prof\] split: game code ([\d.]+)%, native runtime ([\d.]+)% \((\d+) samples\)")
PROF_ENTRY = re.compile(r"\[prof\] (game|native) #(\d+) 0x([0-9A-Fa-f]{8}) ([\d.]+)%")
MAP_LINE = re.compile(r"\s*([0-9A-Fa-f]{8})\s+(\S+)")
REGISTRATIONS = [
    re.compile(r"REGISTER_NATIVE_FUNCTION(?:_AS)?\s*\(\s*0x([0-9A-Fa-f]{8})\s*,\s*([A-Za-z_]\w*)"),
    re.compile(r"REGISTER_TRANSLATED_FUNCTION\s*\(\s*0x([0-9A-Fa-f]{8})\s*,\s*([A-Za-z_]\w*)"),
    re.compile(r"PPC_NATIVE_OVERRIDE(?:_VOID)?\s*\(\s*([0-9A-Fa-f]{8})\s*,\s*([A-Za-z_]\w*)"),
]


def load_map(path):
    symbols = []
    if not os.path.exists(path):
        return symbols
    with open(path, errors="replace") as handle:
        for line in handle:
            match = MAP_LINE.match(line)
            if match:
                symbols.append((int(match.group(1), 16), match.group(2)))
    symbols.sort()
    return symbols


def name_for(symbols, address):
    """The symbol containing this address, with its offset; MAP.txt holds starts."""
    low, high, best = 0, len(symbols) - 1, None
    while low <= high:
        mid = (low + high) // 2
        if symbols[mid][0] <= address:
            best = symbols[mid]
            low = mid + 1
        else:
            high = mid - 1
    if best is None or best[1].startswith("0x"):
        return None, 0
    return best[1], address - best[0]


def load_registrations(runtime_src):
    found = {}
    for directory, _, files in os.walk(runtime_src):
        for name in files:
            if not name.endswith((".cpp", ".h", ".hpp", ".inc")):
                continue
            with open(os.path.join(directory, name), errors="replace") as handle:
                text = handle.read()
            for pattern in REGISTRATIONS:
                for match in pattern.finditer(text):
                    found.setdefault(int(match.group(1), 16), match.group(2))
    return found


def parse_log(path):
    """The profiler prints repeatedly; keep the last complete report."""
    split, entries = None, {}
    with open(path, errors="replace") as handle:
        for line in handle:
            match = PROF_SPLIT.search(line)
            if match:
                split = (float(match.group(1)), float(match.group(2)), int(match.group(3)))
                entries = {}
                continue
            match = PROF_ENTRY.search(line)
            if match:
                kind, _, address, percent = match.groups()
                entries[(kind, int(address, 16))] = float(percent)
    return split, entries


def main(argv):
    paths = [value for value in argv if not value.startswith("-")]
    if not paths:
        print(__doc__)
        return 2
    log_path = paths[0]

    game = "mkwii-nx"
    if "--game" in argv:
        game = argv[argv.index("--game") + 1]
    top = int(argv[argv.index("--top") + 1]) if "--top" in argv else 20

    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))   # example-wii-nx
    root = os.path.dirname(here)                                        # the wii-nx checkout
    game_dir = os.path.join(root, "wiigames-nx", game)
    runtime_src = os.path.join(root, "wiicompiled-nx", "runtime", "src")
    if not os.path.isdir(runtime_src):
        runtime_src = os.path.join(os.path.dirname(root), "wiicompiled", "runtime", "src")

    symbols = load_map(os.path.join(game_dir, "MAP.txt"))
    registered = load_registrations(runtime_src)
    split, entries = parse_log(log_path)
    if not entries:
        print(f"No [prof] lines in {log_path} (is the profiler enabled?)")
        return 1

    if split:
        print(f"{split[2]} samples: game code {split[0]:.1f}%, native runtime {split[1]:.1f}%\n")

    rows = sorted(entries.items(), key=lambda item: -item[1])[:top]
    print(f"{'':<4}{'address':<12}{'%':>6}  {'where':<9}{'symbol'}")
    replaceable = 0.0
    for (kind, address), percent in rows:
        name, offset = name_for(symbols, address)
        label = name or "(unnamed)"
        if offset:
            label += f"+0x{offset:X}"
        mark = ""
        if address in registered:
            mark = f"  <- already native as {registered[address]}"
        elif kind == "game":
            replaceable += percent
        print(f"{'':<4}0x{address:08X}{percent:>7.1f}%  {kind:<9}{label}{mark}")

    print(f"\n  guest code in the top {len(rows)} with no native replacement: {replaceable:.1f}%")
    print("  (that is the budget a native version of these would draw from)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
