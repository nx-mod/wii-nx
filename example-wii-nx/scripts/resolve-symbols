#!/usr/bin/env python3
"""Find a game's SDK functions by matching code, not addresses.

    scripts/resolve-symbols build  <known.dol> <map.txt> <runtime/src> <signatures.json>
    scripts/resolve-symbols match  <signatures.json> <target.dol> [--out addresses.json]
    scripts/resolve-symbols chain  <known.dol> <resolved.json> <signatures.json>

The engine replaces ~580 guest functions with native code, each registered at one
game's address. Nearly all of them are Nintendo's own SDK libraries, which are
the same compiled code in every game - only the addresses they were linked at
differ. So a function can be recognised by its instructions instead:

  build   takes a game we already run, its function map (addresses, used as
          function boundaries) and the runtime sources (which name the functions
          we replace), and writes a signature and a body per function.
  match   scans another game's DOL for those signatures, then follows the calls:
          a matched function's body names its callees by position, so every call
          inside it resolves another function - including short ones that cannot
          have a distinctive signature. That repeats until nothing new is found.

Operands that legitimately differ between games are masked out: branch targets,
the immediate of lis/addis, and displacements relative to the small-data
registers (r2/r13). Everything else - opcodes, registers, stack offsets - has to
match exactly.
"""

import collections
import json
import os
import re
import struct
import sys

# Signatures are taken at several lengths and tried longest first: a long window
# is more distinctive, a short one covers small functions and tolerates a game
# being built from a different SDK version.
WINDOWS = (16, 12, 8, 6, 4)
WINDOW = 16          # the length currently being computed

PATTERNS = [
    re.compile(r"REGISTER_NATIVE_FUNCTION(?:_AS)?\s*\(\s*0x([0-9A-Fa-f]{8})\s*,\s*([A-Za-z_]\w*)"),
    re.compile(r"REGISTER_TRANSLATED_FUNCTION\s*\(\s*0x([0-9A-Fa-f]{8})\s*,\s*([A-Za-z_]\w*)"),
    re.compile(r"PPC_NATIVE_OVERRIDE(?:_VOID)?\s*\(\s*([0-9A-Fa-f]{8})\s*,\s*([A-Za-z_]\w*)"),
]


class Dol:
    def __init__(self, data):
        self.data = data
        self.offsets = struct.unpack(">18I", data[0x00:0x48])
        self.addresses = struct.unpack(">18I", data[0x48:0x90])
        self.sizes = struct.unpack(">18I", data[0x90:0xD8])

    def text_sections(self):
        for index in range(7):
            if self.sizes[index]:
                yield self.addresses[index], self.data[self.offsets[index]:self.offsets[index] + self.sizes[index]]

    def read(self, address, length):
        for start, blob in self.text_sections():
            if start <= address < start + len(blob):
                position = address - start
                return blob[position:position + length]
        return b""


def mask(instruction):
    """Zero the operand bits that differ between two games' copies of a function."""
    opcode = instruction >> 26
    if opcode == 18:                      # b / bl: target
        return instruction & 0xFC000003
    if opcode == 16:                      # bc: target
        return instruction & 0xFFFF0003
    if opcode in (15, 3):                 # lis/addis, twi: immediate
        return instruction & 0xFFFF0000
    if 32 <= opcode <= 55 or opcode in (14, 24, 25, 28, 29):
        # d-form loads/stores and addi/ori against the small-data registers
        base = (instruction >> 16) & 31
        if base in (2, 13):
            return instruction & 0xFFFF0000
    return instruction


def signature_of(code):
    if len(code) < WINDOW * 4:
        return None
    words = struct.unpack(f">{WINDOW}I", code[:WINDOW * 4])
    if all(word == 0 for word in words):
        return None
    return struct.pack(f">{WINDOW}I", *(mask(word) for word in words)).hex()


def replaced_functions(runtime_root):
    """{address: name} for every guest function the runtime replaces."""
    found = {}
    for directory, _, files in os.walk(runtime_root):
        for name in files:
            if not name.endswith((".cpp", ".h", ".hpp", ".inc")):
                continue
            with open(os.path.join(directory, name), errors="replace") as handle:
                text = handle.read()
            for pattern in PATTERNS:
                for match in pattern.finditer(text):
                    found.setdefault(int(match.group(1), 16), match.group(2))
    return found


def build(known_dol, map_path, runtime_root, output, every_function=False):
    global WINDOW
    dol = Dol(open(known_dol, "rb").read())
    boundaries = sorted({int(line.split()[0], 16) for line in open(map_path) if line.strip()})
    replacements = replaced_functions(runtime_root)
    wanted = dict(replacements)
    if every_function:
        # Every function in the map, not just the ones we replace: an unnamed
        # function that matches still names its callees through its call sites,
        # which is how the short and the obscure ones get resolved.
        for address in boundaries:
            wanted.setdefault(address, f"sub_{address:08X}")
        print(f"including all {len(wanted)} mapped functions")
    replacements = wanted
    lengths = {address: (boundaries[index + 1] - address)
               for index, address in enumerate(boundaries[:-1]) if address in replacements}
    print(f"{len(replacements)} replaced functions, {len(boundaries)} known boundaries")

    database = {}
    for window in WINDOWS:
        WINDOW = window
        signatures = {}
        for address, name in sorted(replacements.items()):
            length = lengths.get(address)
            if length is None or length < window * 4:
                continue
            signature = signature_of(dol.read(address, window * 4))
            if signature:
                signatures.setdefault(signature, []).append({"name": name, "address": address})
        unique = {key: value[0] for key, value in signatures.items() if len(value) == 1}
        database[str(window)] = unique
        print(f"  {window:>2} instructions: {len(unique):>3} unique "
              f"({len(signatures) - len(unique)} ambiguous)")

    covered = {entry["name"] for table in database.values() for entry in table.values()}
    print(f"  {len(covered)}/{len(replacements)} functions have a signature")

    # Bodies, so matching one function can resolve the ones it calls.
    bodies = {}
    for address, name in sorted(replacements.items()):
        length = lengths.get(address)
        if not length or length > 0x4000 or length < 8:
            continue
        code = dol.read(address, length)
        if len(code) == length:
            bodies[f"0x{address:08X}"] = {"name": name, "code": code.hex()}
    print(f"  {len(bodies)} bodies kept for call following")
    with open(output, "w") as handle:
        json.dump({"windows": database, "bodies": bodies,
                   "names": {f"0x{a:08X}": n for a, n in sorted(replacements.items())}}, handle, indent=1)
    print(f"  wrote {output}")
    return 0


def call_target(instruction, address):
    """Where a bl at `address` goes, or None if this is not a call."""
    if instruction >> 26 != 18 or not instruction & 1:      # bl, not b
        return None
    offset = instruction & 0x03FFFFFC
    if offset & 0x02000000:
        offset -= 0x04000000
    if instruction & 2:                                     # absolute
        return offset & 0xFFFFFFFF
    return (address + offset) & 0xFFFFFFFF


def follow_calls(database, dol, resolved):
    """Resolve more functions from the calls inside ones already resolved.

    The same function in two games has the same instructions, so its calls sit at
    the same offsets. Walking a resolved function's body in both games maps each
    callee across, which reaches functions too short or too common to match on
    their own. Repeat until a pass finds nothing new.
    """
    bodies = database.get("bodies")
    names = database.get("names")
    if not bodies or not names:
        return 0

    by_name = {entry["name"]: (int(address, 16), bytes.fromhex(entry["code"]))
               for address, entry in bodies.items()}
    name_of = {int(address, 16): name for address, name in names.items()}
    gained = 0
    while True:
        found_this_pass = 0
        for name, target_address in list(resolved.items()):
            source = by_name.get(name)
            if source is None:
                continue
            source_address, source_code = source
            target_code = dol.read(target_address, len(source_code))
            if len(target_code) != len(source_code):
                continue
            for position in range(0, len(source_code) - 3, 4):
                source_word = struct.unpack(">I", source_code[position:position + 4])[0]
                target_word = struct.unpack(">I", target_code[position:position + 4])[0]
                if mask(source_word) != mask(target_word):
                    break                                   # bodies diverged: stop here
                source_callee = call_target(source_word, source_address + position)
                if source_callee is None:
                    continue
                callee_name = name_of.get(source_callee)
                if callee_name is None or callee_name in resolved:
                    continue
                target_callee = call_target(target_word, target_address + position)
                if target_callee is not None:
                    resolved[callee_name] = target_callee
                    found_this_pass += 1
        gained += found_this_pass
        if not found_this_pass:
            return gained


def chain(known_dol, resolved_path, output):
    """Build signatures from a game we have already resolved.

    `resolved.json` is a previous match's output: names at addresses in that
    game. Treating it as a second reference bridges games whose code drifted too
    far from the original to match directly - a title from an SDK version in
    between may match both.

    There is no function map here, so a function is taken to run until the next
    resolved address (capped), which is enough for signatures and usually for
    following calls.
    """
    global WINDOW
    dol = Dol(open(known_dol, "rb").read())
    resolved = {name: int(address, 16) for name, address in json.load(open(resolved_path)).items()}
    ordered = sorted(resolved.items(), key=lambda item: item[1])
    starts = sorted({address for _, address in ordered})
    print(f"{len(resolved)} names from {os.path.basename(resolved_path)}")

    database, bodies = {}, {}
    for window in WINDOWS:
        WINDOW = window
        signatures = {}
        for name, address in ordered:
            signature = signature_of(dol.read(address, window * 4))
            if signature:
                signatures.setdefault(signature, []).append({"name": name, "address": address})
        database[str(window)] = {key: value[0] for key, value in signatures.items() if len(value) == 1}
    for name, address in ordered:
        following = next((start for start in starts if start > address), address + 0x400)
        length = min(following - address, 0x1000)
        code = dol.read(address, length)
        if 8 <= len(code) == length:
            bodies[f"0x{address:08X}"] = {"name": name, "code": code.hex()}

    with open(output, "w") as handle:
        json.dump({"windows": database, "bodies": bodies,
                   "names": {f"0x{address:08X}": name for name, address in ordered}}, handle, indent=1)
    print(f"  wrote {output}")
    return 0


def match(signatures_path, target_dol, out_path):
    global WINDOW
    database = json.load(open(signatures_path))["windows"]
    dol = Dol(open(target_dol, "rb").read())
    known = {entry["name"] for table in database.values() for entry in table.values()}

    resolved, ambiguous = {}, set()
    # Longest windows first: a name resolved by a long signature is not revisited.
    for window in sorted((int(key) for key in database), reverse=True):
        signatures = database[str(window)]
        if not signatures:
            continue
        WINDOW = window
        positions = collections.defaultdict(list)
        for start, blob in dol.text_sections():
            for position in range(0, len(blob) - window * 4, 4):
                signature = signature_of(blob[position:position + window * 4])
                if signature:
                    positions[signature].append(start + position)
        for signature, entry in signatures.items():
            if entry["name"] in resolved:
                continue
            hits = positions.get(signature)
            if not hits:
                continue
            if len(hits) > 1:
                ambiguous.add(entry["name"])
                continue
            resolved[entry["name"]] = hits[0]
            ambiguous.discard(entry["name"])

    by_signature = len(resolved)
    database_all = json.load(open(signatures_path))
    followed = follow_calls(database_all, dol, resolved)

    named = {name for name in database_all.get("names", {}).values() if not name.startswith("sub_")}
    if not named:
        named = known
    hit = {name for name in resolved if name in named}
    print(f"{os.path.basename(target_dol)}: {len(hit)}/{len(named)} replacements resolved "
          f"({100.0 * len(hit) / len(named):.1f}%); {by_signature} functions by signature, "
          f"{followed} more by following calls")
    if out_path:
        with open(out_path, "w") as handle:
            json.dump({name: f"0x{address:08X}" for name, address in sorted(resolved.items())
                   if not name.startswith("sub_")}, handle, indent=1)
        print(f"  wrote {out_path}")
    return 0


def main(argv):
    global WINDOW
    if "--window" in argv:
        position = argv.index("--window")
        WINDOW = int(argv[position + 1])
        argv = argv[:position] + argv[position + 2:]
    if not argv:
        print(__doc__)
        return 2
    command, rest = argv[0], argv[1:]
    if command == "build":
        every = "--all-functions" in rest
        rest = [value for value in rest if value != "--all-functions"]
        if len(rest) == 4:
            return build(*rest, every_function=every)
    if command == "chain" and len(rest) == 3:
        return chain(*rest)
    if command == "match" and len(rest) >= 1:
        out = None
        if "--out" in rest:
            out = rest[rest.index("--out") + 1]
            rest = rest[:rest.index("--out")]
        return match(rest[0], rest[1], out)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
