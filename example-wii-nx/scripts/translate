#!/usr/bin/env bash
# Translate a game's code to C++, ready for the wii-nx build.
#
#   scripts/translate <game> [--threads N] [--engine DIR]
#
# <game> is a folder under wiigames-nx/ with its disc extracted (scripts/extract
# or new-game did that). Runs wiicompiled-nx's translator over the game's
# recomp.yml in its four steps:
#
#   1. translate-recursive   every function reachable from the entry points
#   2. emit-base-manifest    the table of translated functions
#   3. generate-data-init    the game's data sections, as initialisers
#   4. emit-build-shards     the C++ grouped into build units, natives bound
#
# and leaves <game>/generated/, which CMake -DWIINX_GAME=<game> builds. A
# re-run only rewrites what changed. Nothing written is ever committed.
#
# --engine DIR  a wiicompiled-nx checkout to use instead of the submodule
# --threads N   translator threads (default 2; each one needs memory)
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)   # the wii-nx checkout

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -ge 1 ] || usage
game=$1; shift
threads=2
engine="$root/wiicompiled-nx"
while [ $# -gt 0 ]; do
    case $1 in
        --threads) threads=$2; shift 2 ;;
        --engine) engine=$(cd "$2" && pwd); shift 2 ;;
        *) usage ;;
    esac
done

dir="$root/wiigames-nx/$game"
project="$dir/recomp.yml"
[ -f "$project" ] || { echo "no game project at $dir" >&2; exit 1; }
[ -d "$dir/disc" ] || { echo "$game has no extracted disc: run wiigames-nx/$game/scripts/extract first" >&2; exit 1; }
[ -d "$engine/translator" ] || {
    echo "no engine at $engine: git submodule update --init wiicompiled-nx, or pass --engine" >&2
    exit 1
}

# The project names the engine by a path relative to the game folder; a
# different checkout has to be the one it finds.
expected=$(cd "$dir/../.." && pwd)/wiicompiled-nx
if [ "$engine" != "$expected" ] && [ "$(cd "$expected" 2>/dev/null && pwd -P)" != "$(cd "$engine" && pwd -P)" ]; then
    echo "recomp.yml finds the engine at $expected; point that at $engine" >&2
    echo "(e.g. ln -s $engine $expected) or translate from a checkout where it is" >&2
    exit 1
fi

# Values the translator takes as arguments rather than from the project.
yaml_value() { sed -n "s/^[[:space:]]*$1:[[:space:]]*\\([^#[:space:]]*\\).*/\\1/p" "$project" | head -1; }
entry=$(sed -n '/entry_points:/{n;s/^[[:space:]]*-[[:space:]]*\([0-9A-Fa-fx]*\).*/\1/p;}' "$project" | head -1)
region=$(yaml_value region)
[ -n "$entry" ] || { echo "recomp.yml has no translation.entry_points" >&2; exit 1; }

export PATH="$PATH:$HOME/.dotnet" DOTNET_CLI_TELEMETRY_OPTOUT=1
command -v dotnet >/dev/null || { echo "dotnet not found: install the .NET 8 SDK" >&2; exit 1; }
cli="$engine/translator/src/Translator.Cli/bin/Release/net8.0/Translator.Cli.dll"
if [ ! -f "$cli" ]; then
    echo "building the translator"
    dotnet build -c Release "$engine/translator/src/Translator.Cli" >/dev/null
fi

# Translation is memory-hungry: stop cleanly instead of taking the machine
# down with it (it has crashed small hosts). MIN_FREE_MB overrides.
min_free_kb=$(( ${MIN_FREE_MB:-600} * 1024 ))
step() {
    local name=$1; shift
    echo "== $name"
    local start=$SECONDS
    nice -n 10 dotnet "$cli" "$@" &
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        local free
        free=$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null || echo "$min_free_kb")
        if [ "${free:-$min_free_kb}" -lt "$min_free_kb" ]; then
            kill -9 "$pid" 2>/dev/null
            echo "   stopped: under $(( min_free_kb / 1024 )) MB free. Try --threads 1." >&2
            exit 1
        fi
        sleep 2
    done
    wait "$pid" || { echo "   $name failed" >&2; exit 1; }
    echo "   done in $(( SECONDS - start ))s"
}

out="$dir/generated"
step translate-recursive translate-recursive "$entry" --project "$project" \
    --outdir "$out/functions" --output-metadata "$out/base_translation_output.json" \
    --production-source-bundle "$out/base_translation_sources.bin" \
    --no-function-files --prune-stale --threads "$threads"
step emit-base-manifest emit-base-manifest --project "$project" --out "$dir/build/base" \
    --functions-dir "$out/functions" --translation-output-metadata "$out/base_translation_output.json" \
    ${region:+--region "$region"}
step generate-data-init generate-data-init --project "$project"
step emit-build-shards emit-build-shards --project "$project" \
    --base-metadata "$out/base_translation_output.json" --base-functions-dir "$out/functions" \
    --native-source-dir "$engine/runtime/src" --out "$out/build_shards"

[ -f "$out/build_shards/shards.cmake" ] || { echo "no build_shards/shards.cmake was written" >&2; exit 1; }
echo "$game translated. Build it:"
echo "  cmake -S . -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=\$DEVKITPRO/cmake/Switch.cmake -DWIINX_GAME=$game"
