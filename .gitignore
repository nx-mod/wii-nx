# Nintendo system titles downloaded for reference (fetch-nand); never committed.
/nand/

# Python bytecode from the scripts.
__pycache__/

# Local working notes, not for publication.
/notes/
build-switch/

# Game code and data: extracted from your own disc, never committed.
*.dol
*.rel
*.iso
*.wbfs
disc/
generated/

# Fetched per disc by wiigames-nx/wiisports-nx/scripts/fetch-symbols.
wiigames-nx/wiisports-nx/MAP.txt

# The NAND: system titles downloaded from Nintendo, and the settings and saves
# that go with them. Yours, from your own console or from Nintendo's servers,
# and never committed - the same rule as a disc.
/system/

# A game's function list, when it was built from a symbol map that carries no
# licence (games/*/scripts/fetch-symbols). Crediting is not permission, and it
# is seconds to rebuild.
games/*/functions.map

# The symbol map: supplied by you, like the disc. Its source is not recorded
# here, so it is not published here.
/games/mkwii-nx/MAP.txt
